## Public Sanity configuration (required for CMS-backed pages)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2023-10-01

## Contact form email integration (required for /api/send-email)
EMAIL_USER=
EMAIL_PASS=

## LinkedIn feed API proxy (required for /api/linkedin-feed)
LINKEDIN_BASE_URL=https://api.linkedin.com
LINKEDIN_ORG_URN=
LINKEDIN_API_VERSION=
LINKEDIN_ACCESS_TOKEN=

## Optional local development toggle for Updates page
NEXT_PUBLIC_LINKEDIN_MOCK=false
